# Laravel
/vendor/
/node_modules/
/.env
/.env.backup
/.phpunit.result.cache
/storage/*.key
/public/hot
/public/storage
/bootstrap/cache/*.php

# Audio / transcripts / images (privacy + size)
/samples/
/storage/app/audio/
/storage/app/private/
/docs/design-references/
/database/*.sqlite

# Binary media — keep nothing except files the app serves from public/
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp3
*.wav
*.m4a
!public/*.png
!public/*.jpg
!public/*.ico

# Laravel runtime cache (generated, not source)
/storage/framework/views/
/storage/framework/sessions/
/storage/framework/cache/
/storage/logs/

# Build artefacts
/public/build/

# IDE
/.idea/
/.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
